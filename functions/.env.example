# Feefo API credentials
FEEFO_UNIWORLD_CLIENT_ID=
FEEFO_UNIWORLD_CLIENT_SECRET=
FEEFO_LUXURY_GOLD_CLIENT_ID=
FEEFO_LUXURY_GOLD_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# Algolia (optional unless Algolia sync is enabled)
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=

# HTTP function access control
# Preferred model: store runtime admins in Firestore collection `admin_users`.
# Optional legacy fallback: comma-separated allowlist of emails permitted to call
# manual/admin endpoints if you need a temporary bootstrap path.
ADMIN_EMAILS=

# Set to true to require Firebase custom claim: { admin: true } in addition to email allowlist.
REQUIRE_ADMIN_CLAIM=false

# Optional shared token for non-interactive service calls (sent as x-sync-token header).
# Browser users signed in through Firebase Auth do not need this.
SYNC_API_TOKEN=
